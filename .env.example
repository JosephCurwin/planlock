# Copy to .env and set APPROVER_TOKEN (e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`).
# Without APPROVER_TOKEN nothing can ever be approved (fail closed).
APPROVER_TOKEN=

# MCP endpoint for the agent: http://127.0.0.1:${PORT}/mcp
PORT=3001
# Human approver channel (never exposed via MCP)
ADMIN_PORT=4001
ADMIN_HOST=127.0.0.1

APPROVAL_MODE=human
DEV_MODE=true
LOG_ROOT=./run
DOMAIN_PROFILE_PATH=./profiles/micropayout.json

# Upstream business MCP (stdio). Default: bundled mock payments server.
UPSTREAM_COMMAND=node
UPSTREAM_ARGS_JSON=["examples/mock-business/server.mjs"]
UPSTREAM_TOOL_TIMEOUT_MS=30000
MOCK_LEDGER_PATH=./run/mock_ledger.jsonl
